// MOVIA — Concesionario Web MVP
// Esquema de datos (Prisma + PostgreSQL).
// Nombres de tablas, campos y FKs en inglés; valores de datos y enums en español.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enums ---

enum Role {
  ADMIN
  ASESOR
}

enum VehicleStatus {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

enum InquiryStatus {
  NUEVA
  EN_CONTACTO
  EN_SEGUIMIENTO
  VENDIDA
  DESCARTADA
}

// --- Modelos ---

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         Role      @default(ASESOR)
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  vehicles     Vehicle[]
  inquiries    Inquiry[]

  @@index([email])
  @@map("users")
}

model Vehicle {
  id           String         @id @default(cuid())
  make         String
  model        String
  year         Int
  price        Int            // Entero en COP, sin decimales
  mileage      Int
  condition    String         // "NUEVO" | "USADO"
  bodyType     String         @map("body_type") // "AUTO" | "SUV" | "CAMIONETA"
  fuel         String
  transmission String
  color        String
  description  String?
  status       VehicleStatus  @default(BORRADOR)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  photos       Photo[]
  inquiries    Inquiry[]
  createdBy    String?        @map("created_by")
  createdByUser User?         @relation(fields: [createdBy], references: [id])

  @@index([status])
  @@index([make])
  @@index([price])
  @@map("vehicles")
}

model Photo {
  id        String   @id @default(cuid())
  url       String
  order     Int      @default(0)
  vehicleId String   @map("vehicle_id")
  vehicle   Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  @@index([vehicleId, order])
  @@map("photos")
}

model Inquiry {
  id            String        @id @default(cuid())
  name          String
  email         String
  phone         String
  message       String
  vehicleId     String?       @map("vehicle_id")
  vehicle       Vehicle?      @relation(fields: [vehicleId], references: [id])
  status        InquiryStatus @default(NUEVA)
  notes         String?       @map("notes") // Observaciones internas
  assignedToId  String?       @map("assigned_to_id")
  assignedTo    User?         @relation(fields: [assignedToId], references: [id])
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  @@index([status])
  @@index([vehicleId])
  @@map("inquiries")
}
