# MOVIA — variables de entorno (copia a .env y rellena los valores)
# .env queda fuera de Git.

# --- Base de datos (PostgreSQL) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=movia
DB_USER=movia
DB_PASSWORD=cambiar_en_produccion
DATABASE_URL=postgresql://movia:cambiar_en_produccion@localhost:5432/movia?schema=public

# --- Backend (Express) ---
PORT=4000
NODE_ENV=development

# --- Autenticación (cookies httpOnly) ---
SESSION_SECRET=cambiar_este_secret_muy_seguro
SESSION_COOKIE_NAME=movia_session
SESSION_MAX_AGE_MS=86400000
SESSION_COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# --- WhatsApp (variable pública para Next.js) ---
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
NEXT_PUBLIC_API_URL=http://localhost:4000
